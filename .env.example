APP_ENV=development
APP_PORT=8000
APP_VERSION=0.1.0

DATA_DIR=./data
DATABASE_URL=sqlite:///./data/omniquant.db

# AI. OmniRoute is primary. OpenRouter is used only after a connection failure or timeout.
# Leave AI_ENABLED=false until the private keys are filled in .env, not in this example.
AI_ENABLED=false
# Local (non-Docker) OmniRoute URL:
AI_BASE_URL=http://127.0.0.1:20128/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=90
AI_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
AI_FALLBACK_API_KEY=
# Must be a chat-completions model id. Decision-only models will return HTTP 400.
AI_FALLBACK_MODEL=

# Docker Compose ignores AI_BASE_URL for the container and uses this instead
# (defaults to host OmniRoute via the Docker Desktop gateway):
# AI_DOCKER_BASE_URL=http://host.docker.internal:20128/v1
