APP_ENV=development
APP_PORT=8000
APP_VERSION=0.1.0

DATA_DIR=./data
DATABASE_URL=sqlite:///./data/omniquant.db

# AI provider (OpenAI-compatible). Leave AI_ENABLED=false if unavailable.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=45

# For Docker + LM Studio on Mac host, use:
# AI_BASE_URL=http://host.docker.internal:1234/v1
